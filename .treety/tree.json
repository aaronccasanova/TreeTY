{
  "version": 1,
  "defaults": {
    "env": {
      "TREETY_WORKSPACE": "development"
    },
    "restartPolicy": "manual"
  },
  "tree": [
    {
      "cwd": "packages",
      "kind": "group",
      "id": "packages",
      "name": "Packages",
      "children": [
        {
          "cwd": "core",
          "kind": "terminal",
          "id": "core-shell",
          "name": "Core shell"
        },
        {
          "cwd": "vscode",
          "kind": "terminal",
          "id": "vscode-shell",
          "name": "VS Code adapter shell"
        },
        {
          "kind": "terminal",
          "id": "testing",
          "name": "Test"
        },
        {
          "kind": "group",
          "id": "experiments",
          "name": "Experiments",
          "children": [
            {
              "kind": "terminal",
              "id": "adsf",
              "name": "adsf"
            },
            {
              "kind": "group",
              "id": "adsf-2",
              "name": "adsf",
              "children": [
                {
                  "kind": "group",
                  "id": "hi",
                  "name": "hi",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
