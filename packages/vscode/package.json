{
  "name": "treety",
  "displayName": "TreeTY",
  "description": "Organize persistent VS Code terminals as a hierarchical workspace tree.",
  "version": "0.1.4",
  "publisher": "TreeTY",
  "preview": true,
  "icon": "media/treety.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaronccasanova/TreeTY.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/aaronccasanova/TreeTY#readme",
  "bugs": {
    "url": "https://github.com/aaronccasanova/TreeTY/issues"
  },
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.100.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "TreeTY can launch terminals and commands declared by workspace configuration."
    }
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "tree",
    "workspace",
    "microservices",
    "shells"
  ],
  "activationEvents": [
    "onView:treety.terminals",
    "onCommand:treety.initializeWorkspace",
    "onCommand:treety.initializeGlobalTree",
    "onCommand:treety.openTerminal"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "treety.refresh",
        "title": "Refresh",
        "category": "TreeTY",
        "icon": "$(refresh)"
      },
      {
        "command": "treety.initializeWorkspace",
        "title": "Initialize Workspace",
        "category": "TreeTY",
        "icon": "$(new-folder)"
      },
      {
        "command": "treety.initializeGlobalTree",
        "title": "Initialize Global Tree",
        "category": "TreeTY",
        "icon": "$(globe)"
      },
      {
        "command": "treety.openConfig",
        "title": "Open Configuration",
        "category": "TreeTY",
        "icon": "$(json)"
      },
      {
        "command": "treety.createGroup",
        "title": "Create Group",
        "category": "TreeTY",
        "icon": "$(new-folder)"
      },
      {
        "command": "treety.createTerminal",
        "title": "Create Terminal",
        "category": "TreeTY",
        "icon": "$(add)"
      },
      {
        "command": "treety.renameNode",
        "title": "Rename",
        "category": "TreeTY",
        "icon": "$(edit)"
      },
      {
        "command": "treety.configureNode",
        "title": "Configure",
        "category": "TreeTY",
        "icon": "$(settings-gear)"
      },
      {
        "command": "treety.moveNode",
        "title": "Move",
        "category": "TreeTY",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "treety.showNodeActions",
        "title": "Actions",
        "category": "TreeTY",
        "icon": "$(gear)"
      },
      {
        "command": "treety.deleteNode",
        "title": "Delete",
        "category": "TreeTY",
        "icon": "$(trash)"
      },
      {
        "command": "treety.openTerminal",
        "title": "Open Terminal",
        "category": "TreeTY",
        "icon": "$(terminal)"
      },
      {
        "command": "treety.restartTerminal",
        "title": "Restart Terminal",
        "category": "TreeTY",
        "icon": "$(debug-restart)"
      },
      {
        "command": "treety.stopTerminal",
        "title": "Stop Terminal",
        "category": "TreeTY",
        "icon": "$(debug-stop)"
      },
      {
        "command": "treety.markTerminalAttention",
        "title": "Mark needs attention",
        "category": "TreeTY",
        "icon": "$(bell)"
      },
      {
        "command": "treety.clearTerminalAttention",
        "title": "Clear attention",
        "category": "TreeTY",
        "icon": "$(bell-slash)"
      },
      {
        "command": "treety.addDirectoryToWorkspace",
        "title": "Add Directory to VS Code Workspace...",
        "category": "TreeTY",
        "icon": "$(folder-library)"
      }
    ],
    "configuration": {
      "title": "TreeTY",
      "properties": {
        "treety.confirmBeforeStopping": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before closing a live TreeTY terminal."
        },
        "treety.showStatusDescriptions": {
          "type": "boolean",
          "default": true,
          "description": "Show terminal lifecycle states beside terminal names."
        },
        "treety.explorerDirectorySync": {
          "type": "string",
          "enum": [
            "never",
            "prompt",
            "always"
          ],
          "enumDescriptions": [
            "Do not add project directories to the VS Code workspace automatically.",
            "Ask before adding a configured project directory that is outside the current workspace.",
            "Add configured project directories outside the current workspace when their terminals open."
          ],
          "default": "never",
          "description": "Controls whether opening a TreeTY terminal adds its configured project directory to the VS Code workspace, making it available to Explorer and Source Control. VS Code may reload the extension host when the first folder is added."
        },
        "treety.globalTreeVisibility": {
          "type": "string",
          "enum": [
            "fallback",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Show an existing global tree when at least one open folder does not have a local TreeTY configuration.",
            "Always show the global tree alongside local workspace trees so both scopes can be managed.",
            "Hide the global tree when folders are open."
          ],
          "default": "always",
          "description": "Controls when the global terminal tree appears in windows with open folders. Empty VS Code windows always show the global tree."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.treety/tree.json",
          "**/.config/treety/tree.json"
        ],
        "url": "./schemas/treety.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "treety",
          "title": "TreeTY",
          "icon": "media/treety.svg"
        }
      ]
    },
    "views": {
      "treety": [
        {
          "id": "treety.terminals",
          "name": "Terminal tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "treety.terminals",
        "contents": "Create a global terminal tree or initialize the current workspace.\n[Initialize global TreeTY](command:treety.initializeGlobalTree)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "treety.createTerminal",
          "when": "view == treety.terminals",
          "group": "navigation@1"
        },
        {
          "command": "treety.createGroup",
          "when": "view == treety.terminals",
          "group": "navigation@2"
        },
        {
          "command": "treety.openConfig",
          "when": "view == treety.terminals",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "treety.deleteNode",
          "when": "view == treety.terminals && viewItem =~ /^treetyTerminal/",
          "group": "inline@1"
        },
        {
          "command": "treety.showNodeActions",
          "when": "view == treety.terminals && viewItem =~ /^treetyTerminal/",
          "group": "inline@2"
        },
        {
          "command": "treety.openConfig",
          "when": "view == treety.terminals && viewItem =~ /^treetyWorkspace\\.configured/",
          "group": "navigation@1"
        },
        {
          "command": "treety.initializeWorkspace",
          "when": "view == treety.terminals && viewItem == treetyWorkspace.unconfigured.workspace",
          "group": "navigation@1"
        },
        {
          "command": "treety.initializeGlobalTree",
          "when": "view == treety.terminals && viewItem == treetyWorkspace.unconfigured.global",
          "group": "navigation@1"
        },
        {
          "command": "treety.createTerminal",
          "when": "view == treety.terminals && (viewItem == treetyGroup || viewItem =~ /^treetyWorkspace\\.configured/)",
          "group": "inline@1"
        },
        {
          "command": "treety.createGroup",
          "when": "view == treety.terminals && (viewItem == treetyGroup || viewItem =~ /^treetyWorkspace\\.configured/)",
          "group": "inline@2"
        },
        {
          "command": "treety.deleteNode",
          "when": "view == treety.terminals && viewItem == treetyGroup",
          "group": "inline@3"
        },
        {
          "command": "treety.showNodeActions",
          "when": "view == treety.terminals && viewItem == treetyGroup",
          "group": "inline@4"
        },
        {
          "command": "treety.createGroup",
          "when": "view == treety.terminals && (viewItem == treetyGroup || viewItem =~ /^treetyWorkspace\\.configured/)",
          "group": "navigation@2"
        },
        {
          "command": "treety.createTerminal",
          "when": "view == treety.terminals && (viewItem == treetyGroup || viewItem =~ /^treetyWorkspace\\.configured/)",
          "group": "navigation@1"
        },
        {
          "command": "treety.renameNode",
          "when": "view == treety.terminals && (viewItem == treetyGroup || viewItem =~ /^treetyTerminal/)",
          "group": "modification@1"
        },
        {
          "command": "treety.configureNode",
          "when": "view == treety.terminals && (viewItem == treetyGroup || viewItem =~ /^treetyTerminal/)",
          "group": "modification@2"
        },
        {
          "command": "treety.moveNode",
          "when": "view == treety.terminals && (viewItem == treetyGroup || viewItem =~ /^treetyTerminal/)",
          "group": "modification@3"
        },
        {
          "command": "treety.markTerminalAttention",
          "when": "view == treety.terminals && viewItem =~ /^treetyTerminal\\.[^.]+\\.clearAttention$/",
          "group": "session@1"
        },
        {
          "command": "treety.clearTerminalAttention",
          "when": "view == treety.terminals && viewItem =~ /^treetyTerminal\\.[^.]+\\.needsAttention$/",
          "group": "session@1"
        },
        {
          "command": "treety.restartTerminal",
          "when": "view == treety.terminals && viewItem =~ /^treetyTerminal/",
          "group": "session@2"
        },
        {
          "command": "treety.stopTerminal",
          "when": "view == treety.terminals && viewItem =~ /^treetyTerminal\\.(idle|running|starting)\\./",
          "group": "session@3"
        },
        {
          "command": "treety.deleteNode",
          "when": "view == treety.terminals && (viewItem == treetyGroup || viewItem =~ /^treetyTerminal/)",
          "group": "modification@4"
        },
        {
          "command": "treety.addDirectoryToWorkspace",
          "when": "view == treety.terminals && (viewItem == treetyGroup || viewItem =~ /^treetyTerminal/)",
          "group": "workspace@1"
        }
      ],
      "commandPalette": [
        {
          "command": "treety.openTerminal",
          "when": "false"
        },
        {
          "command": "treety.restartTerminal",
          "when": "false"
        },
        {
          "command": "treety.stopTerminal",
          "when": "false"
        },
        {
          "command": "treety.markTerminalAttention",
          "when": "false"
        },
        {
          "command": "treety.clearTerminalAttention",
          "when": "false"
        },
        {
          "command": "treety.renameNode",
          "when": "false"
        },
        {
          "command": "treety.configureNode",
          "when": "false"
        },
        {
          "command": "treety.moveNode",
          "when": "false"
        },
        {
          "command": "treety.showNodeActions",
          "when": "false"
        },
        {
          "command": "treety.deleteNode",
          "when": "false"
        },
        {
          "command": "treety.addDirectoryToWorkspace",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "pnpm run check && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "check": "tsc -p tsconfig.json --noEmit",
    "package": "node ../../scripts/package-vscode-extension.mjs"
  },
  "dependencies": {
    "@treety/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0"
  }
}
