{
  "name": "@treety/cli",
  "version": "0.0.3",
  "description": "Manage hierarchical terminal workspaces from the command line.",
  "license": "MIT",
  "bin": {
    "treety": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "files": [
    "dist",
    "!dist/*.test.*",
    "!dist/.tsbuildinfo",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronccasanova/TreeTY.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@treety/core": "workspace:*"
  }
}
